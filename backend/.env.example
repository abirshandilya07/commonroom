PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/commonroom.sqlite
# For the built app on port 3001, set APP_ORIGIN=http://localhost:3001.
# Set COOKIE_SECURE=true only when serving over HTTPS.
COOKIE_SECURE=false
# Behind exactly one trusted reverse proxy, set TRUST_PROXY=1.

# Common Room AI. Put a Groq key here (free at https://console.groq.com/keys).
# The key stays on the server and never reaches the browser. Leave empty to keep the AI off.
GROQ_API_KEY=
# Optional: a specific Groq model. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
# Alternative: a Google Gemini key instead (used only when GROQ_API_KEY is empty).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# GIF search (optional). Free key: https://developers.giphy.com/dashboard/ (create an API app).
GIPHY_API_KEY=
